# SITE_ADDRESS vem do .env do servidor:
#   "1-2-3-4.sslip.io" → HTTPS automático (Let's Encrypt) nesse endereço
#   ":80"              → só HTTP, acessando pelo IP
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
