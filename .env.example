# Copie para .env (na raiz) e preencha. O .env não vai para o git.

# ---- Aplicação (vão para o servidor) ----
# Chave do Featherless (LLM)
API_KEY=
# Supabase → Connect → Session pooler (porta 5432)
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Opcionais
# RAG_DESATIVADO=0
# LLM_MODELO=deepseek-ai/DeepSeek-V4.1-Flash-1017
# PG_POOL_MAX=5

# ---- Deploy na AWS (só usadas na sua máquina pelo deploy/aws.py; NÃO vão para o servidor) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# De preferência a mesma região do Supabase (o host do pooler diz qual é) ou a mais próxima.
# A conta da organização só libera us-east-2.
AWS_REGION=us-east-2
# Opcional: tipo da máquina (padrão t3.small, 2 GB de RAM)
# EC2_TIPO=t3.small
